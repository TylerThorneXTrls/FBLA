<!DOCTYPE html>
<html>
<head>
       
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/list.css">
    <meta charset="UTF-8" />
    <title> Lost and Found Manager</title>
   
</head>
<body>
    <div class="main">
        <nav class="navBar">
            <ul>
                <li><a href="http://localhost:5000/form">form</a></li>
                <li><a href="http://localhost:5000/list">list</a></li>
                <li><a href="http://localhost:5000">Home</a></li>

            </ul>
        </nav>
      
        
      <% items.forEach(item => { %>
  <div style="margin-bottom: 20px;">
    <h2 class="itemName">Item: <%= item.itemName %></h2>
    <p class="personName">Found by: <%= item.personName %></p>
    <p class="itemDescription">Description: <%= item.itemDescription %></p>
    <p class="ContactInfo">Contact Info: <%= item.ContactInfo %></p>
    

    <img 
      id="itemImage"
      src="/<%= item.itemImage %>" 
      alt="item image"
      style="width:200px; height:auto;"
    >
  </div>
<% }) %>


 
       
        
    </div>
    
</body>
</html>
