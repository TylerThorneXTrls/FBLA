<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <div class="main">
        <nav class="navBar">
            <ul>
                <li><a href="http://localhost:5000/form">Form</a></li>
                <li><a href="http://localhost:5000/list">List</a></li>
                <li><a href="http://localhost:5000">Home</a></li>

                <li><a href="http://localhost:5000/Admin">Admin</a></li>

            </ul>
        </nav>
        <form id="adminForm">
            <label for="admin">User Name </label>
            <input type="text" id="userName" for="userNmae">
            <label for="admin">Admin </label>
            <input type="text" id="Admin">
            <button type="submit">Verify</button>
        </form>
        <div>
       
                <% items.forEach(item => { %>
                    <div style="margin-bottom: 20px;">
                      <h2 class="itemName">Item: <%= item.itemName %></h2>
                      <p class="personName">Found by: <%= item.personName %></p>
                      <p class="itemDescription">Description: <%= item.itemDescription %></p>
                      <p class="ContactInfo">Contact Info: <%= item.ContactInfo %></p>
                      <button>Accept</button>
                      <button>Deny</button>
                      
                  
                      <img 
                        id="itemImage"
                        src="/<%= item.itemImage %>" 
                        alt="item image"
                        style="width:200px; height:auto;"
                      >
                    </div>
                <% }) %>
            
        </div>

        
    </div>
</body>
<script>
const form = document.getElementById("adminForm")
form.addEventListener('submit', async (e) => {
    e.preventDefault()






    const username = document.getElementById('userName').value
    const password = document.getElementById('Admin').value

    const response = await fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
    })




    

    const data = await response.json()

    if(data.success){
        alert('Login successful!')
        window.location.href = '/admin'
    } else {
        alert('Login failed!')
    }
})
</script>

</html>